# Прод-Caddyfile. Запекается в образ kd-caddy (ops/caddy/Dockerfile).
# KD_DOMAIN приходит из environment контейнера (docker-compose.app.yml → .env).
# TLS-сертификаты Caddy получает сам у Let's Encrypt — нужны только
# A-записи KD_DOMAIN и s3.KD_DOMAIN на IP VPS и открытые 80/443.

# Runtime/error logs must not contain signaling tickets in request URIs.
{
	log {
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers delete
			}
		}
	}
}

{$KD_DOMAIN} {
	encode zstd gzip

	# Internal-эндпоинты (/api/internal/*) — только для docker-сети:
	# LiveKit шлёт webhook'ы напрямую на speedy:3001, мимо Caddy.
	# Наружу этот префикс не существует (defense in depth: даже если
	# будущий internal-роут забудет собственную аутентификацию,
	# снаружи он недостижим).
	handle /api/internal/* {
		respond 404
	}

	# REST API
	handle /api/* {
		reverse_proxy speedy:3001
	}

	# WebSocket-gateway
	handle /ws {
		reverse_proxy speedy:3001
	}

	# Health-проба (удобно для uptime-мониторинга)
	handle /healthz {
		reverse_proxy speedy:3001
	}

	# Public signaling ONLY through the admission gateway. No direct SFU/twirp
	# fallback here; speedy uses LIVEKIT_ADMIN_URL on the private docker network.
	handle /livekit/* {
		reverse_proxy speedy:3001
	}

	# Web-клиент (SPA): всё остальное — статика с fallback на index.html
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}

# MinIO на отдельном поддомене — presigned-подписи (SigV4) включают host
# и путь, path-prefix на основном домене сломал бы их.
s3.{$KD_DOMAIN} {
	reverse_proxy minio:9000
}
