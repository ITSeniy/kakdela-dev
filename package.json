{
  "name": "pizza-parlor",
  "version": "0.8.0",
  "private": true,
  "description": "КакДела — самохостящийся уютный чат на 15-20 друзей. Кодовая тема: Samurai Pizza Cats.",
  "packageManager": "pnpm@9.12.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "echo 'Запусти подсистемы в отдельных терминалах: pnpm dev:speedy / dev:polly / docker:dev'",
    "dev:speedy": "pnpm --filter @kakdela/speedy dev",
    "dev:polly": "pnpm --filter @kakdela/polly tauri:dev",
    "dev:web": "pnpm --filter @kakdela/polly dev",
    "docker:dev": "docker compose -f docker-compose.dev.yml up",
    "docker:down": "docker compose -f docker-compose.dev.yml down",
    "docker:reset": "docker compose -f docker-compose.dev.yml down -v",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "francine": "pnpm --filter @kakdela/francine start",
    "big-cheese": "pnpm --filter @kakdela/big-cheese start"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.67.0"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "ws@>=8 <8.21.0": "^8.21.0",
      "fast-uri@>=3 <3.1.6": "^3.1.6",
      "find-my-way@<9.7.0": "^9.7.0",
      "linkify-it@>=5 <5.0.2": "^5.0.2",
      "@babel/core@<7.29.6": "^7.29.6",
      "postcss@<8.5.23": "^8.5.23",
      "postcss-selector-parser@>=6.1.0 <6.1.3": "^6.1.3",
      "browserslist@<4.28.7": "^4.28.7",
      "nanoid@>=3 <3.3.18": "^3.3.18",
      "esbuild@<=0.24.2": "^0.25.0",
      "esbuild@>=0.27.3 <0.28.1": "^0.28.1"
    },
    "patchedDependencies": {
      "sharp@0.35.0": "patches/sharp@0.35.0.patch"
    }
  }
}
